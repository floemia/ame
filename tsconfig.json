{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    "module": "es2022",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src"]
}
